{
  "realm": "fiap-video",
  "enabled": true,
  "sslRequired": "NONE",
  "displayName": "FIAP Video (local)",
  "clients": [{
    "clientId": "fiap-video-spa",
    "name": "FIAP Video SPA",
    "enabled": true,
    "publicClient": true,
    "standardFlowEnabled": true,
    "directAccessGrantsEnabled": false,
    "serviceAccountsEnabled": false,
    "redirectUris": ["http://localhost:5173/*"],
    "webOrigins": ["http://localhost:5173"],
    "attributes": { "pkce.code.challenge.method": "S256" },
    "protocolMappers": [{
      "name": "fiap-video audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
      "config": { "included.client.audience": "fiap-video-spa", "id.token.claim": "false", "access.token.claim": "true" }
    }]
  }],
  "users": [{
    "username": "admin", "enabled": true, "emailVerified": true,
    "credentials": [{ "type": "password", "value": "fiap123", "temporary": false }]
  }]
}

