# Development-only defaults. Copy to .env to override; never use these in production.
POSTGRES_DB=video_platform
POSTGRES_USER=video_app
POSTGRES_PASSWORD=change-me-postgres-local

RABBITMQ_DEFAULT_USER=video_mq
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-local

MINIO_ROOT_USER=video_minio_admin
MINIO_ROOT_PASSWORD=change-me-minio-local

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-local

# Embedded by Vite at build time. Browser clients must use a publicly reachable URL.
VITE_API_BASE_URL=http://localhost:8080
VITE_KEYCLOAK_URL=http://localhost:8083
VITE_KEYCLOAK_REALM=fiap-video
VITE_KEYCLOAK_CLIENT_ID=fiap-video-spa
KEYCLOAK_ISSUER_URL=http://localhost:8083/realms/fiap-video
CORS_ORIGIN=http://localhost:5173
MINIO_PUBLIC_ENDPOINT=localhost:9000
MAX_UPLOAD_BYTES=524288000
UPLOAD_URL_TTL=15m

